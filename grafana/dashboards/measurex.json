          "queryLanguage": "json",
          "queryText": "[\n  {\n    \"$match\": {\n      \"$expr\": {\n        \"$and\": [\n          { \"$gte\": [\"$timestamp_iso\", { \"$dateTrunc\": { \"date\": { \"$toDate\": { \"$toLong\": \"$__from\" } }, \"unit\": \"second\" } }] },\n          { \"$lt\": [\"$timestamp_iso\", { \"$dateTrunc\": { \"date\": { \"$toDate\": { \"$toLong\": \"$__to\" } }, \"unit\": \"second\" } }] }\n        ]\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"time\": \"$timestamp_iso\",\n      \"type\": \"$type\",\n      \"id\": { \"$toString\": \"$msm_id\" }\n    }\n  },\n  { \"$sort\": { \"time\": -1 } }\n]",
          "queryType": "table",
