      "options": {
        "afterRender": "// Wait 100ms to ensure the HTML has been rendered\nsetTimeout(() => {\n\n  const rows = document.querySelectorAll('.clickable-row');\n\n  rows.forEach(row => {\n    row.onclick = function () {\n      const id = this.getAttribute('data-id');\n\n      if (context && context.grafana && context.grafana.locationService) {\n        context.grafana.locationService.partial({\n          'var-selected_msm_id': id\n        }, true);\n      } else {\n        console.error(\"Error: variable update failed (LocationService is missing)\");\n        alert(\"Grafana Error: check the browser console\");\n      }\n    };\n\n  });\n\n}, 150); ",
        "content": "<div class=\"measure-list-container\">\n  <table class=\"measure-table\" id=\"my-aoi-table\">\n    <thead>\n      <tr>\n        <th>Time</th>\n        <th>Type</th>\n      </tr>\n    </thead>\n    <tbody>\n      {{#each data}}\n      <tr class=\"clickable-row row-{{this.type}}\" data-id=\"{{this.id}}\">\n        <td>{{date this.time \"YYYY-MM-DD HH:mm:ss\"}}</td>\n        <td><span class=\"badge badge-{{this.type}}\">{{this.type}}</span></td>\n      </tr>\n      {{/each}}\n    </tbody>\n  </table>\n</div>",
        "contentPartials": [],
        "defaultContent": "The query didn't return any results.\n",
        "editor": {
          "format": "auto",
          "language": "handlebars"
        },
        "editors": [
          "afterRender",
          "styles"
        ],
        "externalStyles": [],
        "helpers": "",
        "renderMode": "allRows",
        "styles": ".measure-list-container {\n  overflow-y: auto;\n  height: 100%;\n}\n.measure-table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0 2px;\n}\n.measure-table th {\n  text-align: left;\n  padding: 8px;\n  background: rgba(255,255,255,0.05);\n  position: sticky;\n  top: 0;\n}\n.measure-table td {\n  padding: 8px;\n  background: rgba(255,255,255,0.02);\n  cursor: pointer;\n  border-bottom: 1px solid #333;\n}\n.measure-table tr:hover td {\n  background: rgba(255,255,255,0.1);\n}\n.badge {\n  padding: 2px 6px;\n  border-radius: 3px;\n  font-size: 10px;\n  text-transform: uppercase;\n  font-weight: bold;\n}\n.badge-aoi { background: #3274D9; color: white; }\n.badge-iperf { background: #37872D; color: white; }\n.badge-ping { background: #E0752D; color: white; }\n.clickable-row {\n  cursor: pointer;\n}\n.clickable-row:hover td {\n  background-color: rgba(255, 255, 255, 0.1) !important;\n}",
        "wrap": false
      },
      "pluginVersion": "6.2.0",
